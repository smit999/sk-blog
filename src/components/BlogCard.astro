---
import AvatarComponent from '@/components/ui/avatar'
import { Badge } from '@/components/ui/badge'
import { Separator } from '@/components/ui/separator'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
  // parseAuthors, // Commented out
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'

interface Props {
  entry: CollectionEntry<'posts'>; // Corrected collection type
}

const { entry } = Astro.props
// Assuming entry.data.pubDate exists based on posts schema, not entry.data.date
const formattedDate = formatDate(entry.data.pubDate)
const readTime = await getCombinedReadingTime(entry.id)
// Assuming entry.data.authors might not exist, but entry.data.author or post.data.authors (plural) does from content/config.ts for posts
// The parseAuthors function in data-utils likely handles this.
// For consistency with [...slug].astro, let's assume authors can be derived from entry.data.author or entry.data.authors
// const authors = await parseAuthors(entry.data.author ? [entry.data.author] : (entry.data.authors || [])); // Commented out
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0

// Process slug for the link: remove trailing '/index' if present
const postSlug = entry.slug.endsWith('/index') ? entry.slug.slice(0, -'/index'.length) : entry.slug;
const postUrl = `/posts/${postSlug}`;
---

<div
  class="hover:bg-secondary/50 rounded-xl border p-4 transition-colors duration-300 ease-in-out"
>
  <Link
    href={postUrl} // Use the correctly processed URL
    class="flex flex-col gap-4 sm:flex-row"
  >
    {
      entry.data.image && (
        <div class="max-w-3xs sm:shrink-0">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={1200}
            height={630}
            class="object-cover"
          />
        </div>
      )
    }

    <div class="grow">
      <h3 class="mb-1 text-lg font-medium">{entry.data.title}</h3>
      <p class="text-muted-foreground mb-2 text-sm">{entry.data.description}</p>

      <div
        class="text-muted-foreground mb-2 flex flex-wrap items-center gap-x-2 text-xs"
      >
        {/* {
          authors && authors.length > 0 && ( // Check if authors is defined
            <>
              {authors.map((author) => (
                <div class="flex items-center gap-x-1.5">
                  <AvatarComponent
                    client:load
                    src={author.avatar}
                    alt={author.name}
                    fallback={author.name[0]}
                    className="size-5 rounded-full"
                  />
                  <span>{author.name}</span>
                </div>
              ))}
              <Separator orientation="vertical" className="h-4!" />
            </>
          )
        } */}
        <span>{formattedDate}</span>
        {/* <Separator orientation="vertical" className="h-4!" /> */} {/* Also remove separator if authors are removed before it */}
        <span>&bull;</span> {/* Replace separator with a bullet or ensure spacing is okay */}
        <span>{readTime}</span>
        {
          subpostCount > 0 && (
            <>
              <Separator orientation="vertical" className="h-4!" />
              <span class="flex items-center gap-1">
                <Icon name="lucide:file-text" class="size-3" />
                {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
              </span>
            </>
          )
        }
      </div>

      {
        entry.data.tags && (
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map((tag) => (
              <Badge variant="secondary" className="flex items-center gap-x-1">
                <Icon name="lucide:hash" class="size-3" />
                {tag}
              </Badge>
            ))}
          </div>
        )
      }
    </div>
  </Link>
</div>
