---
import { Button } from '@/components/ui/button'; // Assuming Button can be used directly in Astro or wrapped.
import { Icon } from 'astro-icon/components';
---

<div id="subscribe-popup-overlay" class="fixed inset-0 bg-black/30 backdrop-blur-sm z-40 hidden flex items-end justify-center">
  <div id="subscribe-popup" class="bg-background border-border border-t shadow-lg p-6 w-full max-w-md mx-auto rounded-t-lg transform translate-y-full transition-transform duration-300 ease-in-out">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-xl font-semibold">Subscribe to Our Newsletter</h3>
      <button id="close-popup-btn" class="text-muted-foreground hover:text-foreground" title="Close">
        <Icon name="lucide:x" class="size-6" />
      </button>
    </div>
    <p class="text-sm text-muted-foreground mb-4">
      Stay updated with the latest posts and news from our blog. No spam, unsubscribe anytime.
    </p>
    <form id="subscribe-form" class="flex flex-col sm:flex-row gap-2">
      <label for="email-input" class="sr-only">Email address</label>
      <input
        type="email"
        id="email-input"
        name="email"
        placeholder="your.email@example.com"
        required
        class="flex-grow px-3 py-2 border border-input rounded-md text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-transparent"
      />
      <Button type="submit" id="subscribe-submit-btn" className="shrink-0">
        Subscribe
      </Button>
    </form>
    <div id="subscribe-message" class="text-sm mt-3"></div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const popupOverlay = document.getElementById('subscribe-popup-overlay');
    const popup = document.getElementById('subscribe-popup');
    const closeBtn = document.getElementById('close-popup-btn');
    const form = document.getElementById('subscribe-form') as HTMLFormElement;
    const emailInput = document.getElementById('email-input') as HTMLInputElement;
    const messageEl = document.getElementById('subscribe-message');
    const submitBtn = document.getElementById('subscribe-submit-btn');

    if (!popupOverlay || !popup || !closeBtn || !form || !messageEl || !submitBtn) {
      console.warn('Subscribe popup elements not found.');
      return;
    }

    const showPopup = () => {
      if (localStorage.getItem('popupDismissed') !== 'true') {
        popupOverlay.classList.remove('hidden');
        popupOverlay.classList.add('flex');
        // Trigger animation
        setTimeout(() => {
          popup.style.transform = 'translateY(0)';
        }, 50);
      }
    };

    const hidePopup = () => {
      popup.style.transform = 'translateY(100%)';
      setTimeout(() => {
        popupOverlay.classList.add('hidden');
        popupOverlay.classList.remove('flex');
      }, 300); // Match transition duration
    };

    // Show popup after a delay (e.g., 3 seconds)
    // setTimeout(showPopup, 3000);
    // For now, show on load if not dismissed for easier testing
    showPopup();


    closeBtn.addEventListener('click', () => {
      hidePopup();
      localStorage.setItem('popupDismissed', 'true');
    });

    popupOverlay.addEventListener('click', (event) => {
      if (event.target === popupOverlay) {
        hidePopup();
        localStorage.setItem('popupDismissed', 'true');
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = emailInput.value;
      messageEl.textContent = '';
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.textContent = 'Subscribing...';

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ email }),
        });

        const result = await response.json();

        if (response.ok) {
          messageEl.textContent = result.message || 'Thank you for subscribing!';
          messageEl.classList.remove('text-red-500');
          messageEl.classList.add('text-green-500');
          emailInput.value = ''; // Clear input
          setTimeout(() => {
            hidePopup();
            localStorage.setItem('popupDismissed', 'true'); // Also dismiss on successful subscribe
          }, 2000);
        } else {
          messageEl.textContent = result.message || 'Subscription failed. Please try again.';
          messageEl.classList.remove('text-green-500');
          messageEl.classList.add('text-red-500');
        }
      } catch (error) {
        messageEl.textContent = 'An error occurred. Please try again.';
        messageEl.classList.remove('text-green-500');
        messageEl.classList.add('text-red-500');
      } finally {
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = 'Subscribe';
      }
    });
  });
</script>

<style>
  /* Ensures the popup slides from bottom */
  #subscribe-popup-overlay.flex {
    align-items: flex-end; /* Aligns popup to bottom when flex */
  }
</style>
