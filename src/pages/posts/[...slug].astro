---
import { type CollectionEntry, getCollection } from 'astro:content';
import { render } from 'astro:content'; // Keep for now, Erudite data-utils uses it
import Layout from '@/layouts/Layout.astro';
import PostHead from '@/components/PostHead.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import type { BreadcrumbItem } from '@/components/Breadcrumbs.astro';
import { Badge } from '@/components/ui/badge';
import { Icon } from 'astro-icon/components';
import { formatDate } from '@/lib/utils';
import FormattedDate from '@/components/FormattedDate.astro'; // Import FormattedDate
import { SITE } from '@/consts';
import {
  getAdjacentPosts,
  getTOCSections,
  getSubpostsForParent,
  isSubpost,
  getParentPost,
  // parseAuthors // Commented out
} from '@/lib/data-utils';
import TOCSidebar from '@/components/TOCSidebar.astro';
import SubpostsHeader from '@/components/SubpostsHeader.astro';
import SubpostsSidebar from '@/components/SubpostsSidebar.astro';
import PostNavigation from '@/components/PostNavigation.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => {
    // If slug ends with /index, remove it for cleaner URLs
    const slug = post.slug.endsWith('/index') ? post.slug.slice(0, -'/index'.length) : post.slug;
    return {
      params: { slug: slug },
      props: { post }, // Pass the original post object
    };
  });
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props; // post.slug here is the original one, e.g., "category/post-name/index"
const { Content } = await post.render(); // Correct way to get Content component

// const authors = await parseAuthors(post.data.author ? [post.data.author] : (post.data.authors || [])); // Handle single author or authors array
// const displayAuthor = authors.length > 0 ? authors[0].name : (post.data.author || 'Admin'); // Default to 'Admin'
const displayAuthor = post.data.author || 'Admin'; // Simplified for now

const { newer, older, parent } = await getAdjacentPosts(post.id); // Use post.id for adj posts
const tocSections = await getTOCSections(post.id);
const subposts = await getSubpostsForParent(isSubpost(post.id) ? post.id.split('/')[0] : post.id);
const parentP = isSubpost(post.id) ? await getParentPost(post.id) : null;

// Construct breadcrumbs
const breadcrumbItems: BreadcrumbItem[] = [{ href: '/posts', label: 'Blog' }];

// Extract category from the original post slug (e.g., "category/post-name/index")
const slugParts = post.slug.split('/');
if (slugParts.length > 2) { // Check if there's a category part before post-name and index
  const category = slugParts[0];
  // Capitalize first letter for display
  breadcrumbItems.push({ label: category.charAt(0).toUpperCase() + category.slice(1) });
}

if (parentP) {
  // Ensure parentP.slug used for URL is also stripped of /index
  const parentDisplaySlug = parentP.slug.endsWith('/index') ? parentP.slug.slice(0, -'/index'.length) : parentP.slug;
  breadcrumbItems.push({ href: `/posts/${parentDisplaySlug}`, label: parentP.data.title });
}
breadcrumbItems.push({ label: post.data.title });

---

<Layout class="max-w-none">
  <Fragment slot="head">
    <PostHead post={post} />
  </Fragment>

  { (tocSections && tocSections.length > 0) && (
    <Fragment slot="table-of-contents">
      <TOCSidebar sections={tocSections} currentPostId={post.id} />
    </Fragment>
  )}

  { (subposts && subposts.length > 0 || parentP) && (
    <Fragment slot="subposts-navigation">
      <SubpostsHeader parentId={isSubpost(post.id) ? post.id.split('/')[0] : post.id} />
    </Fragment>
  )}

  <div class="grid grid-cols-1 xl:grid-cols-[280px_minmax(0,1fr)_280px] xl:gap-x-8">
    { (subposts && subposts.length > 0 || parentP) && (
      <SubpostsSidebar parentId={isSubpost(post.id) ? post.id.split('/')[0] : post.id} />
    )}

    <article class="prose dark:prose-invert mx-auto w-full max-w-3xl py-8 xl:col-start-2">
      <Breadcrumbs items={breadcrumbItems} />
      <header id="post-title" class="mb-8">
        <h1 class="text-4xl font-bold mb-2">{post.data.title}</h1>
        <div class="text-sm text-muted-foreground flex flex-wrap items-center gap-x-2">
          <!-- <span>By {displayAuthor}</span> -->
          <!-- <span>&bull;</span> -->
          <span><FormattedDate date={post.data.pubDate} /></span>
          {post.data.updatedDate && (
            <>
              <span>&bull;</span>
              <span class="italic">(Updated: <FormattedDate date={post.data.updatedDate} />)</span>
            </>
          )}
        </div>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map(tag => (
              <a href={`/tags/${tag.toLowerCase()}`}>
                <Badge variant="secondary">
                  <Icon name="lucide:hash" class="size-3 mr-1" />
                  {tag}
                </Badge>
              </a>
            ))}
          </div>
        )}
      </header>

      <Content />

      <PostNavigation newerPost={newer} olderPost={older} parentPost={parent} />
    </article>
  </div>
</Layout>

<style is:global>
  .prose img {
    border-radius: 0.5rem;
    margin-left: auto;
    margin-right: auto;
  }
</style>
