---
import Layout from '@/layouts/Layout.astro';
import PageHead from '@/components/PageHead.astro';
import BlogCard from '@/components/BlogCard.astro';
import PaginationComponent from '@/components/ui/pagination'; // Erudite's pagination component
import { SITE } from '@/consts';
import { getCollection } from 'astro:content';

// Cleaned up duplicate/commented imports from previous merge
export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft);
  const sortedPosts = allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

  // Generate paths for category navigation - needs all posts to derive all categories
  const uniqueCategorySlugs = new Set<string>();
  sortedPosts.forEach(post => { // Use sortedPosts or allPosts, doesn't matter much for category list
    const slugParts = post.slug.split('/');
    if (slugParts.length > 1) {
      uniqueCategorySlugs.add(slugParts[0]);
    }
  });
  const categoriesForNav = Array.from(uniqueCategorySlugs).map(slug => ({
    name: slug.charAt(0).toUpperCase() + slug.slice(1),
    href: `/posts/${slug}/`
  })).sort((a, b) => a.name.localeCompare(b.name));

  // Pass categoriesForNav via props to each page generated by paginate
  // This way, each paginated page has access to the full list of categories
  return paginate(sortedPosts, {
    pageSize: 5,
    props: { categoriesForNav } // Pass categories to each page
  });
}

const { page, categoriesForNav } = Astro.props; // `page` is injected by paginate, categoriesForNav from props
const postsToDisplay = page.data; // Posts for the current page

const pageTitle = `Blog Posts ${page.totalPages > 1 ? `- Page ${page.currentPage}` : ''}`;
const pageDescription = `Page ${page.currentPage} of blog posts from ${SITE.title}.`;
---

<Layout>
  <Fragment slot="head">
    <PageHead title={pageTitle} description={pageDescription} />
  </Fragment>

  <section class="py-8">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold mb-8 text-center">{pageTitle}</h1>

      {categoriesForNav.length > 0 && (
        <div class="mb-12 text-center"> {/* Increased bottom margin */}
          <h2 class="text-2xl font-semibold mb-4">Categories</h2>
          <div class="flex flex-wrap justify-center gap-3"> {/* Increased gap */}
            {categoriesForNav.map(cat => (
              <a href={cat.href} class="bg-muted text-muted-foreground hover:bg-muted/80 hover:text-foreground px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                {cat.name}
              </a>
            ))}
          </div>
        </div>
      )}

      {postsToDisplay.length === 0 ? (
        <p class="text-center text-muted-foreground">No posts found.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {postsToDisplay.map(post => (
            <BlogCard entry={post} />
          ))}
        </div>
      )}

      {page.totalPages > 1 && (
        <div class="mt-12 flex justify-center">
          <PaginationComponent
            currentPage={page.currentPage}
            totalPages={page.totalPages}
            prevPageUrl={page.url.prev} // Pass direct URL from Astro's page object
            nextPageUrl={page.url.next} // Pass direct URL from Astro's page object
            // Props might need adjustment based on actual PaginationComponent implementation
          />
        </div>
      )}
    </div>
  </section>
</Layout>
