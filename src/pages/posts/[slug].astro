---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PostHead from '@/components/PostHead.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import type { BreadcrumbItem } from '@/components/Breadcrumbs.astro';
import { Badge } from '@/components/ui/badge';
import { Icon } from 'astro-icon/components';
import { SITE } from '@/consts';
import {
  getAdjacentPosts,
  getTOCSections,
  getSubpostsForParent,
  isSubpost,
  getParentPost
} from '@/lib/data-utils';
import TOCSidebar from '@/components/TOCSidebar.astro';
import SubpostsHeader from '@/components/SubpostsHeader.astro';
import SubpostsSidebar from '@/components/SubpostsSidebar.astro';
import PostNavigation from '@/components/PostNavigation.astro';
import { Fragment } from 'astro/components';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
// const Content = post.rendered.Content;

const { newer, older, parent } = await getAdjacentPosts(post.id);
const tocSections = await getTOCSections(post.id);
const subposts = await getSubpostsForParent(isSubpost(post.id) ? post.id.split('/')[0] : post.id);
const parentP = isSubpost(post.id) ? await getParentPost(post.id) : null;

const breadcrumbItems: BreadcrumbItem[] = [
  { href: '/posts', label: 'Blog' },
];
breadcrumbItems.push({ label: post.data.title });
---

<Layout class="max-w-none">
  <Fragment slot="head">
    <PostHead post={post} />
  </Fragment>

  {tocSections && tocSections.length > 0 && (
    <Fragment slot="table-of-contents">
      <TOCSidebar sections={tocSections} currentPostId={post.id} />
    </Fragment>
  )}

  {(subposts && subposts.length > 0 || parent) && (
    <Fragment slot="subposts-navigation">
      <SubpostsHeader parentId={isSubpost(post.id) ? post.id.split('/')[0] : post.id} />
    </Fragment>
  )}

  <div class="grid grid-cols-1 xl:grid-cols-[280px_minmax(0,1fr)_280px] xl:gap-x-8">
    {(subposts && subposts.length > 0 || parent) && (
      <SubpostsSidebar parentId={isSubpost(post.id) ? post.id.split('/')[0] : post.id} />
    )}

    <article class="prose dark:prose-invert mx-auto w-full max-w-3xl py-8 xl:col-start-2">
      <Breadcrumbs items={breadcrumbItems} />
      <header id="post-title" class="mb-8">
        <h1 class="text-4xl font-bold mb-2">{post.data.title}</h1>
        <div class="text-sm text-muted-foreground flex flex-wrap items-center gap-x-2">
          <span>By {post.data.author || 'Admin'}</span>
          <span>&bull;</span>
          <span>{post.data.pubDate.toLocaleDateString()}</span>
          {post.data.updatedDate && (
            <>
              <span>&bull;</span>
              <span class="italic">(Updated: {post.data.updatedDate.toLocaleDateString()})</span>
            </>
          )}
        </div>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {post.data.tags.map(tag => (
              <a href={`/tags/${tag.toLowerCase()}`}>
                <Badge variant="secondary">
                  <Icon name="lucide:hash" class="size-3 mr-1" />
                  {tag}
                </Badge>
              </a>
            ))}
          </div>
        )}
      </header>

      <Fragment set:html={post.body} />

      <PostNavigation newerPost={newer} olderPost={older} parentPost={parent} />
    </article>
  </div>
</Layout>

<style is:global>
  .prose img {
    border-radius: 0.5rem;
    margin-left: auto;
    margin-right: auto;
  }
</style> 