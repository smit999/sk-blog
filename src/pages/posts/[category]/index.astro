---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PageHead from '@/components/PageHead.astro';
import BlogCard from '@/components/BlogCard.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import type { BreadcrumbItem } from '@/components/Breadcrumbs.astro';
import { SITE } from '@/consts';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({data}) => !data.draft);
  const uniqueCategories = new Set<string>();
  allPosts.forEach(post => {
    const slugParts = post.slug.split('/'); // e.g., "category/post-name"
    if (slugParts.length > 1) {
      uniqueCategories.add(slugParts[0]);
    }
  });

  return Array.from(uniqueCategories).map(category => {
    return {
      params: { category: category },
    };
  });
}

const { category } = Astro.params;
const allPosts = await getCollection('posts', ({data}) => !data.draft);

const filteredPosts = allPosts.filter(post => {
  const slugParts = post.slug.split('/');
  return slugParts.length > 1 && slugParts[0] === category;
}).sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

const categoryTitleCase = category.charAt(0).toUpperCase() + category.slice(1);
const pageTitle = `${categoryTitleCase} Posts`;
const pageDescription = `All posts in the category "${categoryTitleCase}" from ${SITE.title}.`;

const breadcrumbItems: BreadcrumbItem[] = [
  { href: '/posts', label: 'Blog' },
  { label: categoryTitleCase } // Current category page, not linked
];
---

<Layout>
  <Fragment slot="head">
    <PageHead title={pageTitle} description={pageDescription} />
  </Fragment>

  <section class="py-8">
    <div class="container mx-auto px-4">
      <div class="mb-8">
        <Breadcrumbs items={breadcrumbItems} />
      </div>
      <h1 class="text-4xl font-bold mb-8 text-center">{pageTitle}</h1>

      {filteredPosts.length === 0 ? (
        <p class="text-center text-muted-foreground">No posts found in this category.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {filteredPosts.map(post => (
            <BlogCard entry={post} />
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
