---
import { getCollection } from 'astro:content';
const posts = await getCollection('posts');
const tagSet = new Set(posts.flatMap(post => post.data.tags ?? []));
const tags = Array.from(tagSet).sort();
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Tags | My Astro Blog</title>
    <meta name="description" content="Browse all tags used in the blog." />
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans m-0">
    <main class="max-w-2xl mx-auto my-12 p-6 bg-white rounded-2xl shadow-lg">
      <a href="/" class="text-blue-600 hover:underline text-sm">← Back to Home</a>
      <h1 class="text-2xl font-bold mb-6">All Tags</h1>
      <section>
        {tags.length === 0 ? (
          <p class="text-gray-500">No tags found.</p>
        ) : (
          <div class="flex flex-wrap gap-3">
            {tags.map(tag => (
              <a href={`/tags/${tag}/`} class="inline-block px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-sm font-medium hover:bg-blue-100 transition">#{tag}</a>
            ))}
          </div>
        )}
      </section>
    </main>
  </body>
</html> 