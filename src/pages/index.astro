---
import '/src/styles/global.css';
import { getCollection } from 'astro:content';
import SubscribeModal from '../components/SubscribeModal.astro';
const posts = await getCollection('posts');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>My Astro Blog</title>
		<meta name="description" content="A fast, modern blog built with Astro and Markdown." />
	</head>
	<body class="bg-gray-50 text-gray-900 font-sans m-0">
		<main class="max-w-2xl mx-auto my-12 p-6 bg-white rounded-2xl shadow-lg">
			<h1 class="text-4xl font-bold mb-2">My Astro Blog</h1>
			<p class="text-gray-500 mb-8">A fast, modern blog built with Astro, Markdown, and Cloudflare Pages.</p>
			<section>
				{posts.sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)).map(post => (
					<article class="mb-10 pb-8 border-b border-gray-200 last:border-b-0 last:pb-0">
						<h2 class="text-2xl font-semibold mb-1">
							<a href={"/posts/" + post.slug + "/"} class="text-blue-600 hover:underline">{post.data.title}</a>
						</h2>
						<div class="text-gray-400 text-sm mb-2">
							{new Date(post.data.pubDate).toLocaleDateString()} &middot; {post.data.author ?? 'Admin'}
						</div>
						<p class="mb-2 text-gray-700">{post.data.description}</p>
						{post.data.tags && (
							<div class="mt-2 flex flex-wrap gap-2">
								{post.data.tags.map(tag => (
									<a href={`/tags/${tag}/`} class="inline-block px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-xs font-medium hover:bg-blue-100 transition">#{tag}</a>
								))}
							</div>
						)}
					</article>
				))}
			</section>
		</main>
		
		<SubscribeModal />
	</body>
</html>
